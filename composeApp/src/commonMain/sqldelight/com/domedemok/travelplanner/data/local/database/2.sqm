-- Migration v2 → v3: add the ItineraryDayEntity table (offline cache for the
-- itinerary day documents). Fresh installs get this table from the .sq schema
-- directly; this migration brings already-installed databases up to date.

CREATE TABLE ItineraryDayEntity (
    tripId    TEXT    NOT NULL,
    id        TEXT    NOT NULL,
    dayNumber INTEGER NOT NULL,
    date      INTEGER NOT NULL,
    placeIds  TEXT    NOT NULL,
    PRIMARY KEY (tripId, id)
);

CREATE INDEX itinerary_trip_index ON ItineraryDayEntity(tripId);
